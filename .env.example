# MySQL connection (MYSQL_DSN takes precedence when set)
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=phone_center

# Required for production authentication
JWT_SECRET=replace-with-a-long-random-secret

# Optional when starting the binary outside the project root
# APP_ROOT=C:\path\to\Phone-Center
PORT=8080
